# Copy to .env.local, then replace the placeholder values before starting MySQL.
MYSQL_ROOT_PASSWORD=replace_with_random_local_password
MYSQL_USER=sdo_local
MYSQL_PASSWORD=replace_with_random_local_password
# JWT_SECRET must be Base64 for at least 64 random bytes (HS512).
JWT_SECRET=replace_with_base64_of_64_random_bytes
# APP_CRYPTO_SECRET_KEY must be exactly 16, 24 or 32 ASCII bytes.
APP_CRYPTO_SECRET_KEY=replace_with_32_ascii_characters
